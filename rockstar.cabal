cabal-version: 3.0
name: rockstar
version: 0.1.0.0
synopsis: An independent Codex chat harness
build-type: Simple

common settings
  default-language: GHC2021
  default-extensions: OverloadedStrings LambdaCase
  ghc-options: -Wall
  build-depends:
    base >=4.20 && <5,
    aeson >=2.2,
    async,
    base64-bytestring,
    bytestring,
    containers,
    crypton,
    directory,
    entropy,
    filepath,
    http-client,
    http-client-tls,
    http-types,
    memory,
    network,
    optparse-applicative,
    process,
    stm,
    temporary,
    text,
    time,
    unix >=2.8.7,
    wai,
    warp

common implementation
  hs-source-dirs: src
  other-modules:
    Rockstar.Auth.Error
    Rockstar.Auth.Internal
    Rockstar.Auth.OAuth
    Rockstar.Auth.Storage
    Rockstar.Auth.Types
    Rockstar.Chat.Internal
    Rockstar.Chat.Types
    Rockstar.Codex
    Rockstar.Http
    Rockstar.Interrupt

library
  import: settings, implementation
  exposed-modules:
    Rockstar.Auth
    Rockstar.Chat
    Rockstar.Cli

executable rockstar
  default-language: GHC2021
  ghc-options: -Wall -threaded -rtsopts
  hs-source-dirs: app
  main-is: Main.hs
  build-depends: base, rockstar

test-suite rockstar-test
  import: settings, implementation
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options: -threaded -rtsopts
  other-modules:
    Rockstar.Auth
    Rockstar.Chat
    Rockstar.Cli
    AuthSpec
    ChatSpec
    CliSpec
    CodexSpec
    TestSupport
  build-depends: hspec
  build-tool-depends: rockstar:rockstar
